{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miangedan.example/v1/scoring-result.schema.json",
  "title": "ScoringResult",
  "description": "面个蛋评分服务输出（ScoreVersion，追加式）。追踪 PRD-001 Scoring & Decision Model、FR-021~FR-025。每个结果关联模型、提示词、量表、权重、证据与计算版本；历史版本永不改写，纠正以新版本实现。",
  "type": "object",
  "required": ["schema_version", "score_id", "score_version", "scoring_request_id", "project_id", "round_sequence", "attempt_id", "data_region", "rubric_version", "dimension_results", "round_total", "gate_result", "result_status", "explanations", "version_lineage", "computed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "score_id": { "type": "string", "format": "uuid" },
    "score_version": { "type": "integer", "minimum": 1, "description": "同一 attempt 内的版本序号；复核产生新版本" },
    "scoring_request_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "round_sequence": { "type": "integer", "minimum": 1, "maximum": 5 },
    "attempt_id": { "type": "string", "format": "uuid" },
    "data_region": { "enum": ["cn", "eu", "intl"] },
    "rubric_version": { "type": "string" },
    "dimension_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["dimension", "weight", "score_status", "is_critical"],
        "properties": {
          "dimension": { "enum": ["professional_competence", "problem_solving", "communication", "experience_evidence", "behavioral_collaboration", "learning_adaptability"] },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
          "score_status": { "enum": ["scored", "insufficient_evidence", "uncovered", "not_applicable", "locked_carried"] },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "未评分为 null；文字模式 oral_delivery 记 not_evaluated 而非 0" },
          "is_critical": { "type": "boolean" },
          "gate_passed": { "type": ["boolean", "null"], "description": "关键维度是否 ≥60；非关键维度为 null" },
          "anchor_citations": {
            "type": "array",
            "description": "插值必须引用锚点等级与证据",
            "items": {
              "type": "object",
              "required": ["anchor_levels", "evidence_ids"],
              "properties": {
                "anchor_levels": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
                "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "rationale": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "subscores": {
            "type": "object",
            "description": "沟通维度子项",
            "properties": {
              "structure_clarity": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
              "oral_delivery": {
                "oneOf": [
                  { "type": "integer", "minimum": 0, "maximum": 100 },
                  { "const": "not_evaluated" }
                ],
                "description": "文字模式为 not_evaluated，不记 0 分"
              }
            },
            "additionalProperties": false
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "round_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "按 SCORING-SPEC 加权与取整；评估未完成时为 null" },
    "gate_result": {
      "type": "object",
      "required": ["total_gate_passed", "critical_gate_passed"],
      "properties": {
        "total_gate_passed": { "type": ["boolean", "null"], "description": "round_total ≥ 60（取整后比较）" },
        "critical_gate_passed": { "type": ["boolean", "null"], "description": "全部关键维度 ≥60" },
        "failed_critical_dimensions": { "type": "array", "items": { "type": "string" } },
        "weak_dimensions": { "type": "array", "items": { "type": "string" }, "description": "非关键维度 <60 记弱项" },
        "insufficient_dimensions": { "type": "array", "items": { "type": "string" } },
        "uncovered_dimensions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "result_status": { "enum": ["PASS", "FAIL", "EVALUATION_INCOMPLETE"], "description": "证据不足/评分故障/关键转写不可恢复 → EVALUATION_INCOMPLETE，不判失败、不解锁" },
    "incomplete_reason": { "enum": ["insufficient_evidence", "scoring_service_failure", "unrecoverable_transcript", "user_exit", "system_fault", null], "default": null },
    "explanations": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "description": "可解释评分摘要" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "improvements": { "type": "array", "items": { "type": "string" } },
        "input_mode_notes": { "type": ["string", "null"], "description": "输入模式与证据限制说明（如文字模式）" }
      },
      "additionalProperties": false
    },
    "job_match": {
      "type": ["object", "null"],
      "required": ["must_have", "nice_to_have"],
      "properties": {
        "must_have": { "$ref": "#/$defs/match_bucket" },
        "nice_to_have": { "$ref": "#/$defs/match_bucket" },
        "not_displayed_reason": { "enum": ["no_jd", null], "default": null, "description": "无 JD 时不展示匹配百分比" }
      },
      "additionalProperties": false
    },
    "version_lineage": {
      "type": "object",
      "required": ["scorer_version", "model_versions", "prompt_versions", "evidence_snapshot_hash"],
      "properties": {
        "scorer_version": { "type": "string", "description": "评分计算代码版本" },
        "model_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "prompt_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "evidence_snapshot_hash": { "type": "string", "description": "输入证据散列；复核输入必须一致" },
        "supersedes_score_id": { "type": ["string", "null"], "format": "uuid", "description": "复核/重评时指向被替代版本（历史版本保留）" }
      },
      "additionalProperties": false
    },
    "computed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "match_bucket": {
      "type": "object",
      "required": ["match_ratio", "proven", "unproven"],
      "properties": {
        "match_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "proven": { "type": "array", "items": { "type": "string" }, "description": "已证明的 requirement_id" },
        "unproven": { "type": "array", "items": { "type": "string" } },
        "at_risk": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
