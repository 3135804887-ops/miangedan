# =============================================================================
# 面个蛋（MianGeDan）环境变量模板
# -----------------------------------------------------------------------------
# 安全说明：
# 1. 本文件只列变量名称与说明，禁止写入任何真实值。
# 2. 真实值由密钥管理系统注入；本地开发使用个人沙箱凭证，禁止提交。
# 3. 标记 [REGION-SCOPED] 的变量必须按数据区域（cn / eu / intl）分别配置，
#    禁止跨区复用同一套凭证或端点；区域之间不得互相引用。
# 4. 浏览器端永远不得持有模型、支付、数字人供应商密钥（PRD API 原则）。
# 5. 轮换周期与责任人见 docs/security/SECURITY-REQUIREMENTS.md。
# =============================================================================

# ---- 全局（非敏感） ----------------------------------------------------------
DATA_REGION=                    # [REGION-SCOPED] 本部署所属数据区：cn | eu | intl
SERVICE_ENV=                    # dev | staging | production
LOG_LEVEL=                      # info | debug（生产禁止 debug 输出正文内容）

# ---- 身份与账户（Identity） --------------------------------------------------
IDENTITY_ISSUER_URL=            # [REGION-SCOPED] 身份签发方地址
IDENTITY_JWKS_URI=              # [REGION-SCOPED] JWT 公钥集地址
IDENTITY_SIGNING_KEY_REF=       # [REGION-SCOPED] 签名密钥在密钥系统中的引用（非密钥本身）
OAUTH_GOOGLE_CLIENT_ID=         # [REGION-SCOPED]
OAUTH_GOOGLE_CLIENT_SECRET=     # [REGION-SCOPED] 机密
OAUTH_APPLE_CLIENT_ID=          # [REGION-SCOPED]
OAUTH_APPLE_CLIENT_SECRET=      # [REGION-SCOPED] 机密
OAUTH_WECHAT_APP_ID=            # 仅 cn 区
OAUTH_WECHAT_APP_SECRET=        # 仅 cn 区，机密
EMAIL_OTP_PEPPER_REF=           # [REGION-SCOPED] 验证码散列 pepper 的密钥引用

# ---- 数据库（PostgreSQL / Redis） ---------------------------------------------
DATABASE_URL=                   # [REGION-SCOPED] 机密；含连接凭证，指向本区 PostgreSQL
DATABASE_READ_REPLICA_URL=      # [REGION-SCOPED] 机密
REDIS_URL=                      # [REGION-SCOPED] 机密；仅短期会话/限流/锁，不存证据
DB_FIELD_ENCRYPTION_KEY_REF=    # [REGION-SCOPED] 敏感字段独立密钥引用

# ---- 对象存储（S3 兼容，区域化） ----------------------------------------------
OBJECT_STORAGE_ENDPOINT=        # [REGION-SCOPED]
OBJECT_STORAGE_REGION=          # [REGION-SCOPED]
OBJECT_STORAGE_ACCESS_KEY=      # [REGION-SCOPED] 机密
OBJECT_STORAGE_SECRET_KEY=      # [REGION-SCOPED] 机密
OBJECT_STORAGE_BUCKET_UPLOADS=  # [REGION-SCOPED] 原始简历/JD 隔离桶
OBJECT_STORAGE_BUCKET_EXPORTS=  # [REGION-SCOPED] 导出物桶
OBJECT_STORAGE_BUCKET_MEDIA=    # [REGION-SCOPED] 经明确授权的原始音视频桶（默认空）

# ---- Temporal（业务工作流） ----------------------------------------------------
TEMPORAL_ADDRESS=               # [REGION-SCOPED]
TEMPORAL_NAMESPACE=             # [REGION-SCOPED]
TEMPORAL_TLS_CERT_REF=          # [REGION-SCOPED] 证书引用
TEMPORAL_API_KEY=               # [REGION-SCOPED] 机密（如适用）

# ---- WebRTC / 实时媒体（LiveKit 基线） -----------------------------------------
WEBRTC_SFU_URL=                 # [REGION-SCOPED]
WEBRTC_API_KEY=                 # [REGION-SCOPED] 机密；仅媒体面使用
WEBRTC_API_SECRET=              # [REGION-SCOPED] 机密；仅媒体面使用
WEBRTC_TURN_URL=                # [REGION-SCOPED]
WEBRTC_TURN_USERNAME=           # [REGION-SCOPED] 机密
WEBRTC_TURN_CREDENTIAL=         # [REGION-SCOPED] 机密

# ---- LLM（经供应商适配层，禁止业务代码直连） ------------------------------------
LLM_PRIMARY_BASE_URL=           # [REGION-SCOPED] 中国区内容不默认调用境外模型
LLM_PRIMARY_API_KEY=            # [REGION-SCOPED] 机密
LLM_SECONDARY_BASE_URL=         # [REGION-SCOPED] 备用供应商
LLM_SECONDARY_API_KEY=          # [REGION-SCOPED] 机密
LLM_MODEL_PINNED_VERSION=       # [REGION-SCOPED] 固定模型版本（治理要求）

# ---- ASR ----------------------------------------------------------------------
ASR_PRIMARY_BASE_URL=           # [REGION-SCOPED]
ASR_PRIMARY_API_KEY=            # [REGION-SCOPED] 机密
ASR_SECONDARY_BASE_URL=         # [REGION-SCOPED]
ASR_SECONDARY_API_KEY=          # [REGION-SCOPED] 机密

# ---- TTS ----------------------------------------------------------------------
TTS_PRIMARY_BASE_URL=           # [REGION-SCOPED]
TTS_PRIMARY_API_KEY=            # [REGION-SCOPED] 机密
TTS_SECONDARY_BASE_URL=         # [REGION-SCOPED]
TTS_SECONDARY_API_KEY=          # [REGION-SCOPED] 机密

# ---- 数字人（Avatar） ------------------------------------------------------------
AVATAR_PRIMARY_BASE_URL=        # [REGION-SCOPED]
AVATAR_PRIMARY_API_KEY=         # [REGION-SCOPED] 机密
AVATAR_SECONDARY_BASE_URL=      # [REGION-SCOPED]
AVATAR_SECONDARY_API_KEY=       # [REGION-SCOPED] 机密
AVATAR_CHARACTER_LICENSE_REF=   # [REGION-SCOPED] 固定授权角色库授权链凭证引用

# ---- 支付（区域化；回调验签） -----------------------------------------------------
PAYMENT_PROVIDER=               # [REGION-SCOPED] 供应商中立标识，如 psp_cn_primary
PAYMENT_MERCHANT_ID=            # [REGION-SCOPED]
PAYMENT_API_KEY=                # [REGION-SCOPED] 机密
PAYMENT_WEBHOOK_SIGNING_SECRET= # [REGION-SCOPED] 机密；回调签名验证与重放防护
PAYMENT_INVOICE_PROVIDER_KEY=   # [REGION-SCOPED] 机密；发票/收据服务

# ---- 邮件 / 通知 -----------------------------------------------------------------
EMAIL_PROVIDER_BASE_URL=        # [REGION-SCOPED]
EMAIL_PROVIDER_API_KEY=         # [REGION-SCOPED] 机密
EMAIL_FROM_ADDRESS=             # [REGION-SCOPED] 发件人地址（非机密）

# ---- 监控与可观测（OpenTelemetry） ------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=    # [REGION-SCOPED]
OTEL_EXPORTER_OTLP_HEADERS=     # [REGION-SCOPED] 机密（鉴权头）
OTEL_SERVICE_NAME=              # 服务名（非机密）
STATUS_PAGE_API_KEY=            # [REGION-SCOPED] 机密；状态页发布
ERROR_TRACKING_DSN=             # [REGION-SCOPED] 机密；错误追踪（正文内容禁止上报）
